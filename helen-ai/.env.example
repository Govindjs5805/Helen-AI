# Helen AI environment variables — copy to .env and fill in.
# These are loaded at build time by Vite. Do NOT commit your real .env file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Leave blank to use the same host as the frontend on port 8000. Set an explicit
# URL when the API is hosted separately (for example, https://api.example.com).
VITE_DOCUMENT_API_URL=
